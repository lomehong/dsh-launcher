<UserControl x:Class="DshLauncher.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 字段行：标签在左（固定宽），控件在右（可拉伸） -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Verbose}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="FieldRow" TargetType="Border">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContainer}">

            <!-- 页头 -->
            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="修改后点「保存更改」写入 config.json；环境变量 (DSH_*) 优先级更高，仍可覆盖文件值。"
                       Foreground="{DynamicResource Brush.Muted}" FontSize="13" Margin="0,0,0,20"/>

            <!-- ========== 网络 ========== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="网络"/>
                        <TextBlock Style="{StaticResource CardSub}" Text="下载源与代理配置"/>
                    </StackPanel>

                    <!-- npm 源 -->
                    <Border Style="{StaticResource FieldRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="npm 源"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                           Text="registry"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="RegistryBox" Width="340" MinHeight="36"
                                         VerticalAlignment="Center"
                                         Text="{Binding Registry, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="npmmirror" FontSize="11" Padding="8,4" MinWidth="60"
                                            Margin="0,0,6,0" Tag="https://registry.npmmirror.com"
                                            Click="PresetRegistry_Click"/>
                                    <Button Content="官方" FontSize="11" Padding="8,4" MinWidth="60"
                                            Tag="https://registry.npmjs.org"
                                            Click="PresetRegistry_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- GitHub 代理 -->
                    <Border Style="{StaticResource FieldRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="GitHub 代理"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                           Text="留空 = 自动用内置列表"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="GithubProxyBox" Width="340" MinHeight="36"
                                         VerticalAlignment="Center"
                                         Text="{Binding GithubProxy, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="ghfast" FontSize="11" Padding="8,4" MinWidth="60"
                                            Margin="0,0,6,0" Tag="https://ghfast.top/"
                                            Click="PresetProxy_Click"/>
                                    <Button Content="gh-proxy" FontSize="11" Padding="8,4" MinWidth="60"
                                            Tag="https://gh-proxy.com/"
                                            Click="PresetProxy_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========== 安全 ========== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="安全"/>
                        <TextBlock Style="{StaticResource CardSub}" Text="下载校验与外部目录保护"/>
                    </StackPanel>

                    <!-- 完整性校验 -->
                    <Border Style="{StaticResource FieldRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="下载完整性校验"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                           Text="integrity"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="IntegrityStrict" Content="strict" GroupName="Integrity"
                                             Margin="0,0,20,0" Checked="IntegrityStrict_Checked"/>
                                <RadioButton x:Name="IntegrityLax" Content="lax" GroupName="Integrity"
                                             Margin="0,0,20,0" Checked="IntegrityLax_Checked"/>
                                <RadioButton x:Name="IntegrityNone" Content="none" GroupName="Integrity"
                                             Checked="IntegrityNone_Checked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 外部保护 -->
                    <Border Style="{StaticResource FieldRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="外部插件保护"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                           Text="protectExternal"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ProtectExternalCheck"
                                      Content="不接管 link:/file: 进来的开发检出依赖"
                                      VerticalAlignment="Center" IsChecked="{Binding ProtectExternal}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========== 运行时 ========== -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="运行时"/>
                        <TextBlock Style="{StaticResource CardSub}" Text="日志与 Node 版本"/>
                    </StackPanel>

                    <!-- 日志级别 -->
                    <Border Style="{StaticResource FieldRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="日志级别"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                           Text="logLevel"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="LogSilent"  Content="silent"  GroupName="LogLevel"
                                             Margin="0,0,20,0" Checked="LogSilent_Checked"/>
                                <RadioButton x:Name="LogInfo"    Content="info"    GroupName="LogLevel"
                                             Margin="0,0,20,0" Checked="LogInfo_Checked"/>
                                <RadioButton x:Name="LogVerbose" Content="verbose" GroupName="LogLevel"
                                             Checked="LogVerbose_Checked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Node 版本 -->
                    <Border Style="{StaticResource FieldRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Node 版本"/>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                                           Text="镜像索引失败时兜底"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="PinnedNodeBox" MinHeight="36" Padding="9,7"
                                     VerticalAlignment="Center"
                                     Text="{Binding PinnedNodeVersion, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 操作区 -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="BtnSave" Content="保存更改" Style="{StaticResource BtnPrimary}"
                        Padding="18,9" MinWidth="120" Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button x:Name="BtnReload" Content="重新加载" Padding="14,7" MinWidth="90"
                        Margin="0,0,10,0" Click="BtnReload_Click"/>
                <Button x:Name="BtnOpenFolder" Content="打开配置目录" Padding="14,7" MinWidth="110"
                        Click="BtnOpenFolder_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Margin="0,12,0,0"
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
