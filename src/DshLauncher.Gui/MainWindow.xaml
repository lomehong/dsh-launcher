<Window x:Class="DshLauncher.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DshLauncher.Gui.Views"
        Title="DeepSeek Harness (dsh) 启动器"
        Height="820" Width="1280" MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        StateChanged="Window_StateChanged"
        Icon="pack://siteoforigin:,,,/app.ico">
    <!-- WindowChrome：接管整个窗口框架——客户区铺满（消除 Win11 顶部 DWM 浅色边），
         CaptionHeight 提供标题栏拖拽/双击最大化，ResizeBorderThickness 提供原生边缘缩放 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 标题栏按钮：透明底 + 悬停高亮 -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.CaptionHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.CaptionPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionBtnClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                <Setter Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主题菜单行：跟主题的自绘行 -->
        <Style x:Key="ThemeMenuRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Padding="12,8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource Brush.Bg}"
            BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== 自定义标题栏（拖拽/缩放由 WindowChrome 提供） ========== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Brush.Sidebar}">
                <Border VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource Brush.BorderSoft}"/>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <Image x:Name="TitleIcon" Width="18" Height="18"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DeepSeek Harness (dsh) 启动器" FontSize="12"
                               Foreground="{DynamicResource Brush.Muted}"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnTheme" Style="{StaticResource CaptionBtn}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnTheme_Click" ToolTip="切换主题（浅色 / 深色 / 自动）">
                        <Grid>
                            <Ellipse Width="12" Height="12" StrokeThickness="1.3"
                                     Stroke="{DynamicResource Brush.CaptionGlyph}" Fill="Transparent"/>
                            <Path Data="M 6 0.65 A 5.35 5.35 0 0 0 6 11.35 Z"
                                  Fill="{DynamicResource Brush.CaptionGlyph}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnMin_Click" ToolTip="最小化">
                        <Rectangle Width="10" Height="1" Fill="{DynamicResource Brush.CaptionGlyph}"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnMax_Click" ToolTip="最大化 / 还原">
                        <Grid>
                            <Rectangle x:Name="MaxGlyph" Width="10" Height="10"
                                       Stroke="{DynamicResource Brush.CaptionGlyph}" StrokeThickness="1" Fill="Transparent"/>
                            <Canvas x:Name="RestoreGlyph" Visibility="Collapsed">
                                <Rectangle Canvas.Left="3" Canvas.Top="0.5" Width="7" Height="7"
                                           Stroke="{DynamicResource Brush.CaptionGlyph}" StrokeThickness="1" Fill="Transparent"/>
                                <Rectangle Canvas.Left="0.5" Canvas.Top="3" Width="7" Height="7"
                                           Stroke="{DynamicResource Brush.CaptionGlyph}" StrokeThickness="1" Fill="{DynamicResource Brush.Bg}"/>
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionBtnClose}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnClose_Click" ToolTip="关闭（最小化到托盘）">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource Brush.CaptionGlyph}"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========== 主内容（原布局） ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Sidebar}"
                        BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <!-- 品牌区 -->
                        <StackPanel DockPanel.Dock="Top" Margin="14,10,12,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="9"
                                        Background="{DynamicResource Brush.Primary}">
                                    <TextBlock Text="dsh" Foreground="White" FontWeight="Bold"
                                               FontSize="13" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DeepSeek Harness" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="HeaderVersion" Text="v1.5.0" FontSize="11"
                                               Foreground="{DynamicResource Brush.Verbose}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- 分隔线 -->
                            <Border Height="1" Background="{DynamicResource Brush.BorderSoft}"
                                    Margin="0,16,0,6"/>
                        </StackPanel>

                        <!-- 导航项 -->
                        <ListBox x:Name="NavList" DockPanel.Dock="Top"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 SelectionChanged="NavList_SelectionChanged"
                                 SelectedIndex="0">
                            <ListBoxItem Content="总览"/>
                            <ListBoxItem Content="插件"/>
                            <ListBoxItem Content="设置"/>
                            <ListBoxItem Content="高级"/>
                        </ListBox>

                        <!-- 底部：web 状态徽章 -->
                        <Border DockPanel.Dock="Bottom" Margin="14,10,14,16" CornerRadius="8"
                                Background="{DynamicResource Brush.PanelBg}" Padding="12,9">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="WebStatusDot" Width="8" Height="8"
                                             Fill="{DynamicResource Brush.Verbose}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="WebStatusText" Text="web 未运行" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.Muted}"/>
                                </StackPanel>
                                <TextBlock x:Name="PortText" Text="端口 3080 · 空闲" FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Verbose}" Margin="15,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 主内容 + 日志（右侧上下分栏） -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="LogRow" Height="200"/>
                    </Grid.RowDefinitions>

                    <!-- 内容区 -->
                    <Grid Grid.Row="0" x:Name="ContentArea" Margin="26,16,26,14">
                        <v:DashboardView x:Name="DashboardView"/>
                        <v:PluginsView x:Name="PluginsView" Visibility="Collapsed"/>
                        <v:SettingsView x:Name="SettingsView" Visibility="Collapsed"/>
                        <v:AdvancedView x:Name="AdvancedView" Visibility="Collapsed"/>
                    </Grid>

                    <!-- 分隔条 -->
                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                            Background="{DynamicResource Brush.BorderSoft}"/>

                    <!-- 日志面板（终端风） -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Sidebar}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 日志工具条 -->
                            <DockPanel Grid.Row="0" Margin="18,9,18,5" LastChildFill="False">
                                <TextBlock Text="终端日志" Foreground="{DynamicResource Brush.Muted}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Border Width="1" Height="12" Background="{DynamicResource Brush.Border}"
                                        VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <Button x:Name="BtnClearLog" Content="清空" DockPanel.Dock="Right"
                                        FontSize="11.5" MinWidth="58" Padding="9,3"
                                        Click="BtnClearLog_Click"/>
                                <Button x:Name="BtnRecheck" Content="重新自检" DockPanel.Dock="Right"
                                        FontSize="11.5" MinWidth="72" Padding="9,3" Margin="0,0,6,0"
                                        Click="BtnRecheck_Click"/>
                                <Button x:Name="BtnOpenBrowser" Content="打开浏览器" DockPanel.Dock="Right"
                                        Style="{StaticResource BtnPrimary}" FontSize="11.5"
                                        MinWidth="82" Padding="9,3" Margin="0,0,6,0"
                                        Click="BtnOpenBrowser_Click" IsEnabled="False"/>
                                <Button x:Name="BtnStopWeb" Content="停止" DockPanel.Dock="Right"
                                        FontSize="11.5" MinWidth="58" Padding="9,3" Margin="0,0,6,0"
                                        Click="BtnStopWeb_Click" IsEnabled="False"/>
                                <Button x:Name="BtnStartWeb" Content="启动 web" DockPanel.Dock="Right"
                                        Style="{StaticResource BtnPrimary}" FontSize="11.5"
                                        MinWidth="82" Padding="9,3" Margin="0,0,6,0"
                                        Click="BtnStartWeb_Click"/>
                            </DockPanel>

                            <!-- 日志文本 -->
                            <RichTextBox x:Name="LogBox" Grid.Row="1"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Code, Consolas"
                                         FontSize="12"
                                         Background="Transparent"
                                         Foreground="{DynamicResource Brush.LogText}"
                                         BorderThickness="0"
                                         Padding="18,2,14,8"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        <!-- 主题菜单：自绘 Popup（跟当前主题；StaysOpen=False 点外部自动关闭） -->
        <Popup x:Name="ThemePopup" StaysOpen="False" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=BtnTheme}"
               Placement="Bottom" HorizontalOffset="-152" VerticalOffset="2">
            <Border CornerRadius="8" MinWidth="196" Margin="8"
                    Background="{DynamicResource Brush.CardBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Padding="5,4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <Button x:Name="RowLight" Style="{StaticResource ThemeMenuRow}" Tag="light" Click="ThemeItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="#FBBF24"/>
                            <TextBlock Text="浅色" Margin="10,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center"/>
                            <Path x:Name="RowLightCheck" Data="M 0 4 L 3 7 L 8.5 0.5" Visibility="Collapsed"
                                  Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RowDark" Style="{StaticResource ThemeMenuRow}" Tag="dark" Click="ThemeItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="#6366F1"/>
                            <TextBlock Text="深色" Margin="10,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center"/>
                            <Path x:Name="RowDarkCheck" Data="M 0 4 L 3 7 L 8.5 0.5" Visibility="Collapsed"
                                  Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RowAuto" Style="{StaticResource ThemeMenuRow}" Tag="auto" Click="ThemeItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0.5" Color="#FBBF24"/>
                                        <GradientStop Offset="0.5" Color="#6366F1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="自动（跟随系统）" Margin="10,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center"/>
                            <Path x:Name="RowAutoCheck" Data="M 0 4 L 3 7 L 8.5 0.5" Visibility="Collapsed"
                                  Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
    </Border>
</Window>
